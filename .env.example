# ===== 后端 API =====
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ===== LLM 配置 =====
# 必填：OpenAI 兼容 API 的 Key
LLM_API_KEY=
# OpenAI 兼容的 API 地址（DeepSeek / GLM / OpenAI 均可）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称
LLM_MODEL=deepseek-v4-flash
# LLM 参数（以下为默认值，可按需调整）
# DeepSeek V4 默认开启思考模式；关闭后 temperature 分级才会生效
# LLM_THINKING_ENABLED=false
# LLM_TEMPERATURE_THINK=0.8
# LLM_TEMPERATURE_ACT=0.5
# LLM_MAX_TOKENS=4096

# ===== 数据库 =====
# SQLite 单文件（默认，无需额外配置）
# DATABASE_URL=sqlite+aiosqlite:///./backend/data/lifelab.db
