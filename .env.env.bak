# ===== 后端 API =====
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ===== LLM 配置 =====
# 必填：LLM API Key
LLM_API_KEY=
# OpenAI 兼容的 API 地址（DeepSeek / GLM / OpenAI 均可）
LLM_BASE_URL=https://api.deepseek.com
# 模型名称
LLM_MODEL=deepseek-v4-flash

# ===== 数据库 =====
# SQLite 单文件（默认，无需配置）
# DATABASE_URL=sqlite+aiosqlite:///./backend/data/lifelab.db
